{
  "name": "vite-plugin-fastly",
  "version": "0.2.0",
  "description": "vite-plugin-fastly",
  "keywords": [
    "compute-at-edge",
    "edge-computing",
    "fastly",
    "fastly-compute",
    "serverless",
    "viceroy",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "repository": "github:cyco130/vite-plugin-fastly",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./dist/plugin.js",
    "./runner": "./dist/runner.js",
    "./types": "./types.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "test": "pnpm run /^test:/",
    "test:typecheck": "tsc -p tsconfig.json --noEmit",
    "test:lint": "eslint . --max-warnings 0",
    "test:package": "publint"
  },
  "dependencies": {
    "http-proxy-3": "^1.23.2",
    "kill-em-all": "0.1.0"
  },
  "devDependencies": {
    "@cyco130/eslint-config": "^9.0.1",
    "@fastly/cli": "^15.1.0",
    "@fastly/js-compute": "^3.42.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "@fastly/js-compute": "3",
    "vite": "~7.3 || 8"
  },
  "engines": {
    "node": "22 || 24 || 25 || 26"
  }
}
